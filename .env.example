# 봇 정체성 (설계 문서 §0 — 이름 확정 시 변경)
CARDGAME_BOT_NAME=CardGameBot

# 자체 SQLite (§1.1 — 중앙봇 central.db 와 분리)
CARDGAME_DB_PATH=data/cardgame.db

# 중앙봇 연동 (§1.1)
CARDGAME_CENTRAL_API_BASE=http://localhost:8000
CARDGAME_CENTRAL_API_KEY=
# false 면 코인/XP 호출을 로컬 스텁으로 처리한다 (중앙봇 없이 개발할 때)
CARDGAME_CENTRAL_API_ENABLED=false

# 커맨드가 동작할 채널. 비우면 전체 허용.
CARDGAME_ALLOWED_CHANNEL_IDS=[]

# 관리자 대시보드 디스코드 OAuth (§10.2)
CARDGAME_DISCORD_CLIENT_ID=
CARDGAME_DISCORD_CLIENT_SECRET=
CARDGAME_DISCORD_REDIRECT_URI=http://localhost:8080/admin/auth/callback

# 운영에서는 반드시 임의의 긴 값으로 교체할 것
CARDGAME_SESSION_SECRET=dev-insecure-change-me

# 최초 Owner 로 지정할 디스코드 유저 ID 목록
CARDGAME_BOOTSTRAP_OWNER_IDS=[]
