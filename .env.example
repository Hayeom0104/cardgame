# Copy this file to `.env` and fill in deployment-local values.
# Never commit real API keys, passwords, or signing secrets.
DECKOUT_DB=runtime/deckout.db
DECKOUT_CENTRAL_URL=http://127.0.0.1:8000
DECKOUT_API_KEY=
DECKOUT_CHANNEL_ID=0
DECKOUT_SKIP_CAPABILITY_CHECK=0

DECKOUT_ADMIN_PASSWORD=
DECKOUT_ADMIN_SECRET=
DECKOUT_ADMIN_SESSION_HOURS=12

DECKOUT_CONTENT_REPO_PATH=
DECKOUT_CONTENT_REPO_PUSH=0
